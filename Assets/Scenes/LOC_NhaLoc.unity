--- !u!114 &2140298527
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2140298525}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 09316e613eaf0064193efd7660eaa1b3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LocVatPham
  id: sach_gia_le
  ten: "quy\u1EC3n s\xE1ch"
  kieu: 0
  ghiChu: "GIA L\u1EC4 PH\u1ED4 TH\xD4NG \u2014 in l\u1EA7n th\u1EE9 ba, 1998. C\u1EE7a
    m\u1EB9, k\u1EB9p gi\u1EA5y hai ch\u1ED7."
  trang:
  - "<b>C\xDANG C\xD4 H\u1ED2N</b>\n\nC\xF4 h\u1ED3n l\xE0 vong kh\xF4ng ng\u01B0\u1EDDi
    th\u1EDD c\xFAng. L\u1EC5 v\u1EADt n\xEAn \u0111\u01A1n s\u01A1: ch\xE1o tr\u1EAFng
    n\u1EA5u th\u1EADt lo\xE3ng, v\xEC c\xF4 h\u1ED3n c\u1ED5 nh\u1ECF, \u0111\u1ED3
    \u0111\u1EB7c kh\xF3 nu\u1ED1t; g\u1EA1o, mu\u1ED1i; m\xEDa \u0111\u1EC3 c\u1EA3
    v\u1ECF ch\u1EB7t kh\xFAc; khoai lang lu\u1ED9c; b\xE1nh k\u1EB9o; n\u01B0\u1EDBc
    s\u1EA1ch. B\xE0y l\u1EC5 n\u01A1i vong \u1EDF. Th\u1EAFp nhang, kh\u1EA5n m\u1EDDi.
    L\u1EC5 ch\u01B0a xong kh\xF4ng \u0111\u01B0\u1EE3c d\u1EDDi nhang, kh\xF4ng
    \u0111\u1EC3 nhang t\u1EAFt."
  - "<b>C\u1EA6U SI\xCAU CHO VONG KH\xD4NG N\u01A0I N\u01AF\u01A0NG T\u1EF0A</b>\n\n1.
    B\xE0y l\u1EC5 nh\u01B0 l\u1EC5 c\xFAng c\xF4 h\u1ED3n, \u0111\u1EB7t n\u01A1i
    vong tr\xFA.\n2. B\xE0y n\u01B0\u1EDBc cho ng\u01B0\u1EDDi trong nh\xE0, \u0111\u1EE7
    ng\u01B0\u1EDDi, k\u1EC3 c\u1EA3 ng\u01B0\u1EDDi \u0111\xE3 khu\u1EA5t.\n3. Th\u1EAFp
    nhang, kh\u1EA5n xin vong nh\u1EADn l\u1EC5, b\u1ECF o\xE1n, \u0111i \u0111\u01B0\u1EDDng
    m\xECnh.\n4. <u>H\xF3a gi\u1EA5y tr\u1EA5n: nh\u1EEFng gi\u1EA5y ni\xEAm, gi\u1EA5y
    y\u1EC3m gi\u1EEF vong \u1EDF l\u1EA1i ph\u1EA3i \u0111em \u0111\u1ED1t c\u1EA3,
    \u0111\u1EC3 vong kh\xF4ng c\xF2n b\u1ECB bu\u1ED9c.</u>\n      <i><color=#5A5048>gi\u1EA5y
    ni\xEAm tr\xEAn h\u0169?</color></i>\n5. <u>M\u1EDF n\u01A1i vong tr\xFA \u2014
    c\u1EEDa, kh\xE1m, h\u0169, ti\u1EC3u \u2014 \u0111\u1EC3 vong \u0111i. Kh\xF4ng
    \u0111\xF3ng l\u1EA1i, kh\xF4ng ni\xEAm l\u1EA1i.</u>\n      <i><color=#5A5048>\xD4ng
    \u1EA5y b\u1EA3o kh\xF4ng bao gi\u1EDD \u0111\u01B0\u1EE3c m\u1EDF h\u0169. Kh\xF4ng
    m\u1EDF th\xEC ti\u1EC5n b\u1EB1ng c\xE1ch n\xE0o?</color></i>\n6. R\u1EAFc g\u1EA1o
    mu\u1ED1i theo \u0111\u01B0\u1EDDng ra."
  khiNhat:
  - "Con xin ph\xE9p \xF4ng b\xE0."
  tuDem: 3
  chuaToi: "\u0110\u1ED3 th\u1EDD c\u1EE7a \xF4ng b\xE0. \u0110\u1EEBng l\u1EE5c."
  docTuDem: 0
  chuaDoc: "Mai h\u1EB5ng \u0111\u1ECDc."
