--- !u!114 &1718726326
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1718726325}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 09316e613eaf0064193efd7660eaa1b3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LocVatPham
  id: so_cua_bo
  ten: "s\u1ED5 c\u1EE7a b\u1ED1"
  kieu: 0
  ghiChu: "Cu\u1ED1n s\u1ED5 b\xECa c\u1EE9ng c\u1EE7a b\u1ED1, l\u1EA5y trong k\xE9t."
  trang:
  - "<b>B\xECa</b>\n\n\n        Tr\u1EA7n Quang V\u0169            1959\n       
    Nguy\u1EC5n Th\u1ECB Li\xEAn          1960\n        Tr\u1EA7n Ho\xE0i Phong         
    1980  <color=#5B4A6A>\u2014 14 / 8 / 1996</color>\n        Tr\u1EA7n Ho\xE0i
    Kh\xF4i            1982\n        Tr\u1EA7n Ng\u1ECDc H\xE2n             2 / 4
    / 1995"
  - "<size=15><color=#8A7A68>1</color></size>\n\n<i>10/8/89. G\u1EB7p th\u1EA7y \u1EDF
    c\u1ED5ng \u0111\u1EC1n. M\xECnh ch\u01B0a n\xF3i g\xEC m\xE0 th\u1EA7y \u0111\xE3
    b\u1EA3o: nh\xE0 anh \u0111ang n\u1EE3, n\u1EE3 to. Th\u1EA7y b\u1EA3o th\u1EA7y
    gi\xFAp \u0111\u01B0\u1EE3c.</i>"
  - "<size=15><color=#8A7A68>2</color></size>\n\n<i>Th\u1EA7y mang t\u1EDBi m\u1ED9t
    c\xE1i h\u0169. B\u1EA3o trong \u0111\xF3 l\xE0 m\u1ED9t vong kh\xF4ng ai th\u1EDD.
    H\u1ECFi l\xE0 ai th\xEC th\u1EA7y kh\xF4ng n\xF3i. Nu\xF4i n\xF3 t\u1EED t\u1EBF
    th\xEC n\xF3 cho l\u1ED9c.</i>"
  - "<size=15><color=#8A7A68>3</color></size>\n\n<i>19/8. L\xE0m l\u1EC5. Th\u1EA7y
    c\u1EAFt \xEDt t\xF3c hai v\u1EE3 ch\u1ED3ng b\u1ECF v\xE0o h\u0169, b\u1EA3o
    \u0111\u1EC3 n\xF3 nh\u1EADn ch\u1EE7. Th\u1EA7y ghi t\xEAn c\u1EA3 nh\xE0 v\xE0o
    s\u1EDB, th\u1EA7y gi\u1EEF. N\u0103m c\xE1i ch\xE9n n\u01B0\u1EDBc, m\u1ED7i
    ng\u01B0\u1EDDi m\u1ED9t c\xE1i, cho n\xF3 bi\u1EBFt nh\xE0 n\xE0y c\xF3 nh\u1EEFng
    ai.</i>"
  - "<size=15><color=#8A7A68>4</color></size>\n\n<i>30/8. Tr\xFAng s\u1ED1. Ch\u01B0a
    bao gi\u1EDD ngh\u0129 \u0111\u1EDDi m\xECnh c\xF3 ng\xE0y n\xE0y.</i>"
  - "<size=15><color=#8A7A68>5</color></size>\n\n<i>22/6/96. H\u1EBFt n\u1EE3 r\u1ED3i.
    Nh\xE0 c\u1EEDa, c\u1EEDa h\xE0ng, c\xF3 c\u1EA3.</i>"
  - "<size=15><color=#8A7A68>6</color></size>\n\n<i>V\u1EE3 b\u1EA3o tr\u1EA3 h\u0169
    cho th\u1EA7y, \u0111\u1EE7 r\u1ED3i. M\xECnh th\xEC ti\u1EBFc. \u0110ang \u0111\u01B0\u1EE3c
    th\u1EBF n\xE0y.</i>"
  - "<size=15><color=#8A7A68>7</color></size>\n\n<i>Th\u1EA7y b\u1EA3o mu\u1ED1n
    tr\u1EA3 th\xEC \u0111\u1EE3i qua th\xE1ng b\u1EA3y, th\xE1ng n\xE0y n\xF3 \u0111\u1ED9ng.
    Th\u1EA7y l\xE0m l\u1EC5 gi\u1EEF m\u1EA1ng cho th\u1EB1ng Phong, n\xF3 tu\u1ED5i
    xung. L\u1EA5y \xEDt t\xF3c. \u0110\xE3 c\u1EA5m n\xF3 ra s\xF4ng.</i>"
  - "<size=15><color=#8A7A68>8</color></size>\n\n<i>14/8. Th\u1EB1ng Phong.\n\n\n\n<i><color=#7A6A58>(m\u1ED9t
    v\u1EC7t loang)</color></i></i>"
  - "<size=15><color=#8A7A68>9</color></size>\n\n<i>Th\u1EA7y b\u1EA3o: n\xF3 bi\u1EBFt
    nh\xE0 m\xECnh \u0111\u1ECBnh b\u1ECF n\xF3. Th\u1EA7y gi\u1EEF kh\xF4ng n\u1ED5i.</i>"
  - "<size=15><color=#8A7A68>10</color></size>\n\n<i>M\xECnh kh\xF4ng tin c\xE1i
    th\u1EE9 \u1EA5y n\u1EEFa. Mang ra b\u1EBFn Ph\xE0 C\u0169 n\xE9m r\u1ED3i. Kh\xF4ng
    n\xF3i v\u1EDBi ai, c\u1EA3 v\u1EE3.</i>"
  - "<size=15><color=#8A7A68>11</color></size>\n\n<i>Ra b\u1EBFn th\u1EAFp h\u01B0\u01A1ng
    cho th\u1EB1ng Phong. Th\u1EB1ng Kh\xF4i tr\u01B0\u1EE3t ch\xE2n. Ng\u01B0\u1EDDi
    ta v\u1EDBt k\u1ECBp.</i>"
  - "<size=15><color=#8A7A68>12</color></size>\n\n<i>S\xE1ng ra c\xF3 m\u1ED9t g\xF3i
    \u0111\u1EC3 tr\u01B0\u1EDBc c\u1EEDa. Gi\u1EA5y d\u1EA7u, bu\u1ED9c l\u1EA1t.
    Kh\xF4ng ai g\u1EEDi, kh\xF4ng ai th\u1EA5y ai mang t\u1EDBi. M\u1EDF ra l\xE0
    n\xF3.</i>"
  - "<size=15><color=#8A7A68>13</color></size>\n\n<i>Th\u1EA7y b\u1EA3o n\xF3 t\u1EF1
    v\u1EC1. V\u1EE9t n\xF3 \u0111i l\xE0 n\xF3 l\u1EA5y h\u1EBFt. Th\u1EA7y n\xF3i
    \u0111\xFAng.</i>"
  - "<size=15><color=#8A7A68>14</color></size>\n\n<i>Ch\xE9n th\u1EB1ng Phong v\u1EE1
    h\xF4m n\xF3 \u0111i. M\xECnh ng\u1ED3i d\xE1n l\u1EA1i \u0111\u01B0\u1EE3c.
    C\u0169ng l\xE2u.</i>"
  - "<size=15><color=#8A7A68>15</color></size>\n\n<i>Ch\xE9n th\u1EB1ng Phong m\xECnh
    \u0111em l\xEAn ph\xF2ng th\u1EDD tr\xEAn t\u1EA7ng r\u1ED3i. Cho n\xF3 \u1EDF
    v\u1EDBi \xF4ng b\xE0. N\u1EB1m d\u01B0\u1EDBi \u1EA5y v\u1EDBi c\xE1i kia l\xE0
    \u0111\u1EE7.</i>"
  - "<size=15><color=#8A7A68>16</color></size>\n\n<i>97. X\xE2y nh\xE0 m\u1EDBi.
    Th\u1EA7y b\u1EA3o ph\u1EA3i \u0111\xE0o m\u1ED9t c\xE1i h\u1EA7m cho n\xF3 \u1EDF
    ri\xEAng. C\u1EA3 d\xE3y n\xE0y ch\u1EB3ng nh\xE0 n\xE0o c\xF3 h\u1EA7m, th\u1EE3
    h\u1ECFi m\xE3i. M\xECnh b\u1EA3o \u0111\u1EC3 ch\u1EE9a h\xE0ng.</i>"
  - "<size=15><color=#8A7A68>17</color></size>\n\n<i>Th\xE1ng ch\u1EA1p 97. Th\u1EA7y
    xu\u1ED1ng h\u1EA7m d\xE1n b\xF9a, \u1EDF d\u01B0\u1EDBi \u1EA5y c\u1EA3 bu\u1ED5i
    chi\u1EC1u. L\xEAn b\u1EA3o b\xF9a kh\xF4ng tr\u1ECB \u0111\u01B0\u1EE3c n\xF3,
    ch\u1EC9 gi\u1EEF n\xF3 d\u01B0\u1EDBi \u1EA5y. N\u0103m n\xE0o th\u1EA7y c\u0169ng
    s\u1EBD \u0111\u1EBFn d\xE1n th\xEAm.</i>"
  - "<size=15><color=#8A7A68>18</color></size>\n\n<i>98. C\u1EA3 ph\u1ED1 c\xFAp
    \u0111i\u1EC7n ba h\xF4m. Th\u1EA7y g\u1ECDi sang d\u1EB7n: n\xF3 ch\u1EC9 m\u1EA1nh
    trong t\u1ED1i. Xu\u1ED1ng th\xEC b\u1EADt \u0111i\u1EC7n. M\xECnh s\u01A1n lu\xF4n
    l\xEAn t\u01B0\u1EDDng.</i>"
  - "<size=15><color=#8A7A68>19</color></size>\n\n<i>Th\u1EA7y d\u1EB7n th\xEAm,
    m\xECnh ch\xE9p l\u1EA1i cho kh\u1ECFi qu\xEAn: trong nh\xE0 m\xE0 t\u1ED1i th\xEC
    \u0111\u1EE9ng y\xEAn. \u0110\u1EEBng \u0111i v\u1EC1 ph\xEDa n\xF3. N\xF3 kh\xF4ng
    \u0111i \u0111\u01B0\u1EE3c t\u1EDBi m\xECnh, m\xECnh \u0111i t\u1EDBi n\xF3
    th\xF4i.</i>"
  - "<size=15><color=#8A7A68>20</color></size>\n\n<i>M\xF9ng m\u1ED9t th\xE1ng b\u1EA3y
    n\u0103m \u1EA5y \u0111\xF3ng c\u1EEDa h\xE0ng c\u1EA3 ng\xE0y. Th\u1EA7y b\u1EA3o
    c\u1EA3 nh\xE0 \u1EDF y\xEAn trong nh\xE0. B\xF9a ch\u1EC9 gi\u1EEF \u0111\u01B0\u1EE3c
    trong nh\xE0, ra kh\u1ECFi c\u1ED5ng l\xE0 h\u1EBFt.</i>"
  - "<size=15><color=#8A7A68>21</color></size>\n\n<i>T\u1EEB \u0111\u1EA5y n\u0103m
    n\xE0o m\xF9ng m\u1ED9t th\xE1ng b\u1EA3y c\u0169ng c\xFAng to d\u01B0\u1EDBi
    h\u1EA7m. Th\u1EA7y b\u1EA3o sang th\xE1ng \u1EA5y b\xF9a y\u1EBFu, ph\u1EA3i
    cho n\xF3 \u0103n no.</i>"
  - "<size=15><color=#8A7A68>22</color></size>\n\n<i>9/2000. Th\u1EB1ng Kh\xF4i \u0111i.
    C\xE3i nhau m\u1ED9t tr\u1EADn. M\xECnh n\xF3i n\u1EB7ng.</i>"
  - "<size=15><color=#8A7A68>23</color></size>\n\n<i>M\u1EA5y n\u0103m nay l\xE0m
    \u0103n \u0111i xu\u1ED1ng. Th\u1EA7y b\u1EA3o n\xF3 \u0111\xF3i, c\xFAng th\xEAm.</i>"
  - "<size=15><color=#8A7A68>24</color></size>\n\n<i>Ch\u01B0a k\u1EC3 g\xEC m\xE0
    th\u1EA7y \u0111\xE3 bi\u1EBFt. Th\u1EA7y gi\u1ECFi th\u1EADt.</i>"
  - "<size=15><color=#8A7A68>25</color></size>\n\n<i>Con Nh\xEDm d\u1EA1o n\xE0y
    s\u1ED1t m\xE3i kh\xF4ng d\u1EE9t. Ch\xE9n n\xF3 m\u1EBB r\u1ED3i. M\u1EBB h\xF4m
    n\xE0o m\xECnh kh\xF4ng bi\u1EBFt.</i>"
  - "<size=15><color=#8A7A68>26</color></size>\n\n<i>Th\u1EA7y b\u1EA3o \u0111\u1EC3
    th\u1EA7y lo.</i>"
  - "\n\n\n<color=#8A7A68><i>(trang tr\u1EAFng)</i></color>"
  - "\n\n\n<color=#8A7A68><i>(m\u01B0\u1EDDi m\u1EA5y trang tr\u1EAFng n\u1EEFa)</i></color>"
  - "<b>B\xECa sau, m\u1EB7t trong</b>\n\n\n<i>Th\u1EA7y \u0110\u1ED3ng \u2014 826
    315</i>"
  khiNhat:
  - "S\u1ED5 c\u1EE7a b\u1ED1."
  - "Th\xF4i c\u1EA5t \u0111\xE3. Mai xem."
  tuDem: 1
  chuaToi: 
  docTuDem: 2
  chuaDoc: "Mai h\u1EB5ng \u0111\u1ECDc."
  canCo: 
  chuaCo: 
